# EditorConfig: https://editorconfig.org
# Keeps every editor aligned with the project's formatting rules.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# Hard line breaks are meaningful in Markdown.
[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
